{
  "manifest_version": 3,
  "name": "Gọn — TikTok thu nhỏ & độ trong suốt",
  "version": "1.3.0",
  "description": "Ghim TikTok vào cửa sổ nổi luôn trên cùng, thu nhỏ, chỉnh độ trong suốt và giữ video chạy khi mở tab khác.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://www.tiktok.com/robots.txt*"
      ]
    },
    {
      "matches": [
        "https://www.tiktok.com/robots.txt*"
      ],
      "js": [
        "pin.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_embed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}