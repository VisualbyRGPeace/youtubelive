{
  "manifest_version": 3,
  "name": "Gọn — TikTok thu nhỏ & độ trong suốt",
  "version": "1.1.0",
  "description": "Thu nhỏ, chỉnh độ trong suốt và giữ video TikTok tiếp tục phát khi cửa sổ bị che hoặc mở tab khác.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}